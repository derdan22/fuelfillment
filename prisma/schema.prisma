generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  company   String?
  comment   String?
  createdAt DateTime @default(now())
}
